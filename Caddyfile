# Caddy: HTTPS with automatic certificates (Let's Encrypt for a public name,
# Caddy's own local authority for NOTES_HOST=localhost) in front of the app.
{
	# The admin API stays inside the container.
	admin localhost:2019
}

{$NOTES_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy app:3000 {
		# The app trusts this header only from the Compose network, and Caddy
		# overwrites whatever the client sent with the address it saw.
		header_up X-Forwarded-For {remote_host}
	}

	# Access log on stdout. Credentials and query strings are removed; bodies are never logged.
	log {
		output stdout
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
			request>uri regexp "\?.*$" ""
			wrap json
		}
	}
}
