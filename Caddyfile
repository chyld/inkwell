# Caddy: HTTPS with automatic certificates (Let's Encrypt for a public name,
# Caddy's own local authority for NOTES_HOST=localhost) in front of the app.
{
	# The admin API stays inside the container.
	admin localhost:2019

	# Caddy's own log, used for errors such as a 502 while the app restarts: the
	# same rule as the access log below (method, path, status, duration).
	log default {
		output stdout
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>proto delete
			request>host delete
			request>headers delete
			request>tls delete
			bytes_read delete
			user_id delete
			size delete
			resp_headers delete
			request>uri regexp "\?.*$" ""
			wrap json
		}
	}
}

{$NOTES_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy app:3000 {
		# The app trusts this header only from the Compose network, and Caddy
		# overwrites whatever the client sent with the address it saw.
		header_up X-Forwarded-For {remote_host}
	}

	# Access log on stdout: method, path (query string removed), status and
	# duration only. Everything else Caddy would log, including all headers and
	# the client address, is deleted. Bodies are never logged.
	log {
		output stdout
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>proto delete
			request>host delete
			request>headers delete
			request>tls delete
			bytes_read delete
			user_id delete
			size delete
			resp_headers delete
			request>uri regexp "\?.*$" ""
			wrap json
		}
	}
}
