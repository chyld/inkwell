{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "declaration": false,
    "resolveJsonModule": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts", "src/cli/**/*.ts", "src/tools/**/*.ts"]
}
