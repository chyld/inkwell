# Copy to .env and edit. Only non-secret settings belong here.

# The public hostname: a bare name, no https://, no port, no slash.
# Use NOTES_HOST=localhost to test on your own machine.
NOTES_HOST=chyld-notes.duckdns.org

# Storage limit per user, in MB (1024 = 1 GB). Counts note bodies and images, Trash included.
NOTES_USER_QUOTA_MB=1024

# Notes each agent may create per hour.
NOTES_AGENT_RATE_PER_HOUR=60
